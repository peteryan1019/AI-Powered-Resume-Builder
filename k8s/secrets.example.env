# Copy to k8s/secrets.env. Never commit that file.
# Use URL-safe random values (letters and digits) for both data-store passwords
# so the same value can safely appear inside DATABASE_URL and REDIS_URL.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SAME_POSTGRES_PASSWORD@postgres:5432/resumebuilder
REDIS_URL=redis://default:REPLACE_WITH_SAME_REDIS_PASSWORD@redis:6379

SECRETKEY=REPLACE_WITH_LONG_RANDOM_VALUE
RESEND_API_KEY=re_REPLACE_ME
MAIL_FROM=Tailr <login@contact.resume-builder.dev>
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
APIKEY_2=REPLACE_ME
APIKEY_3=REPLACE_ME
COACH_KEY=REPLACE_ME
# Optional. Remove this line to make the writer use COACH_KEY.
WRITER_KEY=REPLACE_ME
