# Copy this to ".env" ON THE DROPLET (next to docker-compose.yml) and fill in
# real values. docker-compose reads it for ${VAR} substitution.
# NEVER commit the real .env — it holds secrets.

# --- Let's Encrypt ---
LETSENCRYPT_EMAIL=you@example.com

# --- Postgres (DB container uses this; DATABASE_URL is built from it) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- App URLs (single-domain setup: both point at the public site) ---
APP_DOMAIN=resumebuilder.works
FRONTEND_URL=https://resumebuilder.works
BACKEND_URL=https://resumebuilder.works

# --- Session signing secret (long random string) ---
# Sessions are stored in Redis (see REDIS_URL, set per-service in
# docker-compose.yml), so a redeploy or restart no longer signs users out.
# Changing SECRETKEY invalidates every existing cookie, which does.
SECRETKEY=change-me-to-a-long-random-string

# How long a login lasts, in seconds. Optional; defaults to 7 days. The cookie
# max-age and the Redis key TTL both come from this, and both slide forward on
# every response, so an active user is not signed out mid-session.
SESSION_TTL_SECONDS=604800

# --- Transactional email (required in production) ---
# MAIL_FROM must use a sender/domain verified in Resend. Production refuses to
# start without these values so one-time login codes can never leak into logs.
RESEND_API_KEY=re_xxx
MAIL_FROM="Tailr <login@contact.resumebuilder.works>"

# --- Google OAuth ---
# Register this redirect URI in Google Cloud Console:
#   https://resumebuilder.works/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe ---
# REQUIRED to be non-empty: the backend does `new Stripe(STRIPE_SECRET_KEY)` at
# boot, which throws on an empty value. Use at least a Stripe test key.
# Webhook endpoint to register in Stripe: https://resumebuilder.works/webhooks/stripe
# Subscribe it to checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# customer.subscription.paused, customer.subscription.resumed, invoice.paid,
# and invoice.payment_failed.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# --- Vertex AI (used by all AI resume features) ---
# Enable billing and the Vertex AI API in this Google Cloud project. Both the
# flash-lite and pro-preview models used by the app are available at `global`.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Absolute path on the Docker host to a downloaded service-account JSON key.
# Compose mounts it read-only at a fixed path inside the backend containers.
# For local processes outside Docker, this is also the standard ADC variable.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex-service-account.json

# --- Resume worker ---
# Number of resume workflow jobs one worker container processes concurrently.
RESUME_WORKER_CONCURRENCY=2
