# Copy this to ".env" ON THE DROPLET (next to docker-compose.yml) and fill in
# real values. docker-compose reads it for ${VAR} substitution.
# NEVER commit the real .env — it holds secrets.

# --- Let's Encrypt ---
LETSENCRYPT_EMAIL=you@example.com

# --- Postgres (DB container uses this; DATABASE_URL is built from it) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- App URLs (single-domain setup: both point at the public site) ---
FRONTEND_URL=https://resumebuilder.works
BACKEND_URL=https://resumebuilder.works

# --- Session signing secret (long random string) ---
SECRETKEY=change-me-to-a-long-random-string

# --- Google OAuth ---
# Register this redirect URI in Google Cloud Console:
#   https://resumebuilder.works/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe ---
# REQUIRED to be non-empty: the backend does `new Stripe(STRIPE_SECRET_KEY)` at
# boot, which throws on an empty value. Use at least a Stripe test key.
# Webhook endpoint to register in Stripe: https://resumebuilder.works/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# --- Google Gemini API keys (used by the AI resume features) ---
APIKEY_1=your-gemini-api-key
APIKEY_2=your-gemini-api-key
