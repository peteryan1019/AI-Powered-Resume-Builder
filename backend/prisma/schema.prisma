// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// USER
// Created by Prithvi's OAuth flow.
// email comes from Google OAuth profile.
// ─────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleid  String?  @unique
  name      String?
  avatarUrl String?
  stripeCustomerId String?
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  localAuthCredential LocalAuthCredential?
  resumes Resume[]
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  title         String?
  templateId    String
  URL           String @map("jobPostingUrl")
  content       Json?
  pdfData       Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action String
  returnTo String
  stripeCheckoutSessionId String @unique
  stripePaymentIntentId String?
  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  paidAt DateTime?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model LocalAuthCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// PROFILE
// One per user. Stores basic info + social links.
// Populated via resume upload (AI parse) or manual entry.
// ─────────────────────────────────────────
model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info
  headline  String?
  phone     String?
  location  String?
  summary   String?

  // Social / portfolio links
  linkedin  String?
  github    String?
  portfolio String?

  // Resume file (stored in DigitalOcean Spaces, we keep the URL)
  resumeUrl      String?
  resumeFileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections ProfileSection[]
}

// ─────────────────────────────────────────
// PROFILE SECTION
// Each section is a fixed type (enum).
// A user can have one or more sections of the same type
// (e.g. two "Work Experience" sections is unusual but allowed).
// `order` controls display order — update on drag-and-drop.
// ─────────────────────────────────────────
model ProfileSection {
  id        String      @id @default(uuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type      SectionType
  label     String      // display name, e.g. "Work Experience" (user can rename)
  order     Int         // 0-based display order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances ProfileInstance[]
}

// ─────────────────────────────────────────
// PROFILE INSTANCE
// One concrete entry inside a section.
// e.g. one job, one degree, one skill category.
//
// `data` is a flexible JSON field — schema varies by SectionType.
// See comments below for expected shapes.
// ─────────────────────────────────────────
model ProfileInstance {
  id        String         @id @default(uuid())
  sectionId String
  section   ProfileSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  order     Int
  data      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// ─────────────────────────────────────────
// SECTION TYPES
// Fixed enum — frontend uses this to render
// the correct form fields per section.
// ─────────────────────────────────────────
enum SectionType {
  WORK_EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  CERTIFICATIONS
  AWARDS
  LANGUAGES
  VOLUNTEER
}

